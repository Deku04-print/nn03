DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
POSTGRES_PASSWORD=replace-this-local-password
DATABASE_URL=postgresql://nexus:replace-this-local-password@127.0.0.1:5432/nexus
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3456,http://127.0.0.1:3456
FRONTEND_ORIGIN=http://localhost:3456
# Docker Compose uses the service name below. For direct Windows backend runs,
# set this to http://127.0.0.1:11434 in Backend/.env instead.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=256
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_TIMEOUT_SECONDS=15
# Optional bearer token for an authorized Ollama-compatible gateway. Keep it secret.
OLLAMA_API_KEY=
VISUAL_EXPERT_ENABLED=True
# Optional; used only after the authorized internal Git service and repository are provided.
EXPERT_GIT_BASE_URL=
EXPERT_GIT_REPOSITORY=
EXPERT_GIT_ACCESS_TOKEN=
