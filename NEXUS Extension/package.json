{
  "name": "nexus-vscode",
  "displayName": "NEXUS Developer Mentor",
  "description": "Analyze the active VS Code selection with NEXUS and open its web dashboard.",
  "version": "0.1.0",
  "publisher": "nexus-local",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onView:nexus.sidebar", "onCommand:nexus.analyzeSelection", "onCommand:nexus.openDashboard", "onCommand:nexus.toggleChatMode"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "nexus", "title": "NEXUS", "icon": "media/nexus.svg" }]
    },
    "views": {
      "nexus": [{ "id": "nexus.sidebar", "name": "Developer Mentor", "type": "webview" }]
    },
    "commands": [
      { "command": "nexus.analyzeSelection", "title": "NEXUS: Analyze Selection" },
      { "command": "nexus.followUp", "title": "NEXUS: Ask for Another Hint" },
      { "command": "nexus.login", "title": "NEXUS: Sign In" },
      { "command": "nexus.logout", "title": "NEXUS: Sign Out" },
      { "command": "nexus.openDashboard", "title": "NEXUS: Open Web Dashboard" },
      { "command": "nexus.toggleChatMode", "title": "NEXUS: Toggle Normal / Advanced Chat" },
      { "command": "nexus.setApiUrl", "title": "NEXUS: Set Backend URL" }
    ],
    "configuration": {
      "title": "NEXUS",
      "properties": {
        "nexus.apiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8999",
          "description": "Django API base URL, without a trailing slash."
        },
        "nexus.dashboardUrl": {
          "type": "string",
          "default": "http://localhost:3456",
          "description": "Web dashboard URL opened by the extension."
        }
      }
    }
  },
  "scripts": { "package": "vsce package" },
  "devDependencies": { "@vscode/vsce": "^2.26.1" }
}
