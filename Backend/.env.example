DJANGO_SECRET_KEY=replace-with-a-machine-specific-random-secret
JWT_SECRET=replace-with-a-different-machine-specific-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///./worklens_dev.db
CORS_ALLOWED_ORIGINS=http://localhost:3456

# Set the authorized company-hosted Ollama address. No external AI provider is used.
OLLAMA_BASE_URL=http://YOUR_AUTHORIZED_OLLAMA_HOST:5011
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_PREDICT=256
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.2

HUMAN_API_RESPONSE_THRESHOLD=4

# Optional future server-side Git adapter configuration. No vendor or real URL is assumed.
COMPANY_GIT_BASE_URL=
COMPANY_GIT_ORGANIZATION=
COMPANY_GIT_TOKEN=
